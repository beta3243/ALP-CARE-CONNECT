# Local development values. Git-ignored - safe to edit, never committed.
#
# STEP 1 of going live: paste your Resend API key below, then restart `npm run dev`.
# Until this is filled in, the form shows its error state and no mail is sent.
#
# Get one at https://resend.com/api-keys
# Sign up for Resend using alpcareconnect@gmail.com and the test sender below
# can deliver to that same inbox immediately, with no domain setup needed.

RESEND_API_KEY=

# Where enquiries are delivered.
ALP_CONTACT_EMAIL=alpcareconnect@gmail.com

# Who they appear to come from.
# onboarding@resend.dev works out of the box, but ONLY delivers to the email
# address that owns the Resend account. Once your own domain is verified in
# Resend, change this to e.g. "ALP CareConnect <care@alpcareconnect.com>".
ALP_FROM_EMAIL="ALP CareConnect <onboarding@resend.dev>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave blank until the real business numbers/links are supplied.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_INSTAGRAM_URL=
