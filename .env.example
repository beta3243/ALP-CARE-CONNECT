# ---------------------------------------------------------------------------
# ALP CareConnect — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Email delivery (Resend) -----------------------------------------------
# Server-side only. Must NEVER be prefixed with NEXT_PUBLIC_.
# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. This is the confirmed ALP business inbox.
ALP_CONTACT_EMAIL=alpcareconnect@gmail.com

# The "from" address Resend sends as.
# During development you may use Resend's shared testing sender:
#   ALP CareConnect <onboarding@resend.dev>
# Once the ALP domain is added and VERIFIED in Resend, switch to e.g.:
#   ALP CareConnect <care@alpcareconnect.com>
# A Gmail address CANNOT be used as a Resend sender — only a verified domain.
ALP_FROM_EMAIL="ALP CareConnect <onboarding@resend.dev>"

# --- Public site configuration (safe to expose to the browser) -------------
# Canonical site URL, used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://alpcareconnect.com

# WhatsApp number in international format, DIGITS ONLY, no "+" and no spaces.
# Example for an Indian number: 919876543210
# Leave EMPTY until the real number is supplied — the UI then shows a clearly
# marked placeholder instead of inventing a number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Display phone number, e.g. "+91 98765 43210". Leave empty until supplied.
NEXT_PUBLIC_PHONE_DISPLAY=

# Instagram profile URL. Leave empty until supplied.
NEXT_PUBLIC_INSTAGRAM_URL=
